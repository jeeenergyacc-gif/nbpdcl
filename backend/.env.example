# Copy to .env and fill in. Never commit the real .env.

# --- Data source -------------------------------------------------------------
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwL7H9t6G72dgBwjXQQdQOeyN1eWa8rzIqvP95zTaPCkOLc39ir-WQrXbgWONSLLBbj/exec

# --- CORS --------------------------------------------------------------------
# Add the production origin here before deploying.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth --------------------------------------------------------------------
# REQUIRED in production. This signs every JWT — anyone who knows it can forge a
# token for any user, so it must be random, secret, and different per environment.
# Do NOT ship a value that lives in the repo; generate your own:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# If JWT_SECRET is left unset the backend generates a random one at startup and
# logs a warning. Development still works, but every restart invalidates all
# existing tokens — so set it properly for anything long-lived.
JWT_SECRET=

# Single shared demo account — replace with a real user store before go-live.
# There is no per-user identity, no password hashing and no lockout behind these.
DEMO_USERNAME=admin
DEMO_PASSWORD=nbpdcl@2026
